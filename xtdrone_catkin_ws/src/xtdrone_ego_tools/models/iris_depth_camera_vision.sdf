<?xml version="1.0" ?>
<sdf version="1.5">
  <!-- PX4's iris_vision estimator input combined with the depth camera used
       by EGO.  The vision plugin publishes local pose/velocity to the nested
       iris mavlink interface; the iris_vision airframe fuses it instead of
       noisy simulated GPS for indoor centimetre-scale tracking. -->
  <model name="iris_vision">
    <plugin name="vision_plugin" filename="libgazebo_vision_plugin.so">
      <robotNamespace></robotNamespace>
      <pubRate>50</pubRate>
      <!-- Ideal-localization main experiment.  Robustness experiments add
           explicit, recorded pose noise and delay outside this baseline. -->
      <randomWalk>0.0</randomWalk>
      <noiseDensity>0.001</noiseDensity>
      <corellationTime>60.0</corellationTime>
    </plugin>

    <include>
      <uri>model://iris</uri>
    </include>

    <include>
      <uri>model://depth_camera</uri>
      <pose>0.1 0 0 0 0 0</pose>
    </include>
    <joint name="depth_camera_joint" type="revolute">
      <child>depth_camera::link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- A whole-body platform must observe the workspace below the fuselage,
         not only the forward UAV corridor.  This low-resolution downward
         RGB-D sensor provides real ray observations for the continuum arm
         workspace; it does not publish or embed scene geometry. -->
    <model name="down_camera">
      <pose>0 0 -0.05 0 1.57079632679 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>4.15e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.407e-6</iyy><iyz>0</iyz><izz>2.407e-6</izz>
          </inertia>
        </inertial>
        <sensor name="depth_camera" type="depth">
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.57079632679</horizontal_fov>
            <image><format>R8G8B8</format><width>160</width><height>120</height></image>
            <clip><near>0.10</near><far>8.0</far></clip>
          </camera>
          <plugin filename="libgazebo_ros_openni_kinect.so" name="down_camera_controller">
            <cameraName>camera_down</cameraName>
            <alwaysOn>true</alwaysOn><updateRate>15</updateRate>
            <pointCloudCutoff>0.10</pointCloudCutoff>
            <pointCloudCutoffMax>8.0</pointCloudCutoffMax>
            <imageTopicName>rgb/image_raw</imageTopicName>
            <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
            <depthImageTopicName>depth/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
            <pointCloudTopicName>depth/points</pointCloudTopicName>
            <frameName>down_camera_link</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
    <joint name="down_depth_camera_joint" type="fixed">
      <child>down_camera::link</child>
      <parent>iris::base_link</parent>
    </joint>
  </model>
</sdf>
