<?xml version="1.0"?>
<package format="2">
  <name>uav_continuum_opportunity_planner</name>
  <version>0.0.1</version>
  <description>Opportunity-guided planning helpers for a UAV carrying a Qingyu continuum arm.</description>
  <maintainer email="uav@example.com">uav</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>gazebo_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>rospy</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>traj_utils</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>traj_utils</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
</package>
